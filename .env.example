# Copy to .env (local) or set in Vercel → Settings → Environment Variables.
# Never commit .env or .env.local (see .gitignore).

# Firebase client (Firebase Console → Project settings → Your apps)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Auth email action continue URL (full URL, allowlisted in Firebase Auth)
# REACT_APP_AUTH_CONTINUE_URL=https://www.findsomeone.co/profile

# Optional: point local dev at deployed sendEmail API
# REACT_APP_SEND_EMAIL_URL=https://www.findsomeone.co/api/sendEmail

# --- Vercel server only (api/sendEmail.js) — do NOT prefix with REACT_APP_ ---
# RESEND_API_KEY=
# RESEND_FROM=
# FIREBASE_WEB_API_KEY=          # same value as REACT_APP_FIREBASE_API_KEY
# FIREBASE_SERVICE_ACCOUNT_JSON= # full JSON string or use GOOGLE_APPLICATION_CREDENTIALS locally
# REPORT_NOTIFY_EMAIL=
# CONTACT_EMAIL=
